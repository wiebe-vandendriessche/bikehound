# --- BikeHound: local data, NEVER commit ---
# data/ holds the database, and cached embeddings
data/
!data/.gitkeep
# Your real configuration (ntfy topic, your bike's description)
config.yaml
# Your own photos of your bike
reference/*
!reference/.gitkeep
# Logs and databases
*.log
*.sqlite
*.sqlite3
*.db
# Secrets
.env
.env.*
*.pem
*.key
/backup

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Playwright ---
playwright-report/
test-results/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
